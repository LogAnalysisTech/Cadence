# Copy to .env at the repository root. Never commit real credentials.
# Shell / injected environment variables take priority over .env.
# API routing: openrouter (default) or direct.
MODEL_API_ROUTE=openrouter

# Agent passthrough and Cadence / LivePlan LLM refinement.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agent credentials for MODEL_API_ROUTE=direct.
# LLM monitor refinement still uses OPENROUTER_API_KEY / OPENROUTER_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Moatless code-search embeddings.
VOYAGE_API_KEY=

# Modal login: use `modal token new` and its local profile (~/.modal.toml).
# For CI, inject MODAL_TOKEN_ID / MODAL_TOKEN_SECRET into the process environment.
# Keep Modal login credentials out of this file.
# Public experiment parameters remain in runner CLI flags / ExperimentConfig.
